---
interface Props {
	/** トップページを除く階層。最後の要素が現在地になります。 */
	items: { href?: string; label: string }[];
	/** ラッパー。元テーマがページ種別ごとに使い分けているものに合わせます。 */
	variant?: 'single' | 'container' | 'plain';
}

const { items, variant = 'plain' } = Astro.props;

const escape = (s: string) =>
	s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const last = items.length - 1;
const crumbs = items
	.map((item, i) => {
		const label = escape(item.label);
		if (i === last) return ` | <span class="breadcrumb_last" aria-current="page">${label}</span>`;
		return ` | <span>${item.href ? `<a href="${escape(item.href)}">${label}</a>` : label}</span>`;
	})
	.join('');

const inner = `<p id="breadcrumbs"><span><span><a href="/">トップページ</a></span>${crumbs}</span></p>`;
---

{
	variant === 'single' ? (
		<section class="c-breadcrumb c-breadcrumb-single">
			<div class="c-breadcrumb-single--inner l-container--outer" set:html={inner} />
		</section>
	) : (
		<div class={variant === 'container' ? 'breadcrumbs-container' : 'container'} set:html={inner} />
	)
}
