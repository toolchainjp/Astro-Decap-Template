---
import { NAV, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<nav class="site-nav" aria-label="メインナビゲーション">
		<a class="brand" href="/">
			<img src="/uploads/logo.svg" alt={SITE_TITLE} width="160" height="32" />
		</a>

		<input type="checkbox" id="nav-toggle" class="nav-toggle" />
		<label for="nav-toggle" class="nav-toggle-label" aria-label="メニューを開く">
			<span></span><span></span><span></span>
		</label>

		<ul class="nav-list">
			{
				NAV.map((item) => (
					<li class={item.children ? 'has-children' : ''}>
						<a href={item.href} class={isActive(item.href) ? 'active' : ''}>
							{item.label}
						</a>
						{item.children && (
							<ul class="sub-menu">
								{item.children.map((child) => (
									<li>
										<a href={child.href}>{child.label}</a>
									</li>
								))}
							</ul>
						)}
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: #fff;
		border-bottom: 1px solid #e6e6e6;
	}
	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.75rem 1.25rem;
	}
	.brand img {
		display: block;
		height: 32px;
		width: auto;
	}
	.nav-list {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.nav-list > li {
		position: relative;
	}
	.nav-list a {
		display: block;
		padding: 0.5rem 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: #1a1a1a;
		text-decoration: none;
		white-space: nowrap;
	}
	.nav-list a:hover,
	.nav-list a.active {
		color: #0a5c9e;
	}
	.sub-menu {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 12rem;
		list-style: none;
		margin: 0;
		padding: 0.5rem 0;
		background: #fff;
		border: 1px solid #e6e6e6;
		box-shadow: 0 6px 20px rgb(0 0 0 / 8%);
	}
	.has-children:hover .sub-menu,
	.has-children:focus-within .sub-menu {
		display: block;
	}
	.sub-menu a {
		padding: 0.5rem 1rem;
		font-weight: 500;
	}

	/* モバイル */
	.nav-toggle,
	.nav-toggle-label {
		display: none;
	}
	@media (max-width: 900px) {
		.nav-toggle-label {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			width: 26px;
			height: 18px;
			cursor: pointer;
		}
		.nav-toggle-label span {
			display: block;
			height: 2px;
			background: #1a1a1a;
		}
		.nav-list {
			display: none;
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			width: 100%;
			order: 3;
			padding: 0.5rem 0 1rem;
		}
		.nav-toggle:checked ~ .nav-list {
			display: flex;
		}
		.nav-list > li {
			width: 100%;
			border-top: 1px solid #eee;
		}
		.sub-menu {
			display: block;
			position: static;
			border: none;
			box-shadow: none;
			padding: 0 0 0.5rem 1rem;
		}
	}
</style>
