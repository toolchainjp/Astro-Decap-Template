---
import { COMPANY, SITE_TITLE } from '../consts';
import { getNews } from '../lib/collections';
import { newsPermalink } from '../lib/taxonomy';

const news = (await getNews()).slice(0, 3);

const fmt = (d: Date) =>
	`${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<section class="cta">
	<div class="inner">
		<p class="cta-lead">建築の大小関わらず<br />お気軽にご相談ください</p>
		<a class="btn" href="/contact/">お問い合わせ</a>
	</div>
</section>

<footer class="site-footer">
	<div class="inner">
		<div class="about">
			<img class="footer-logo" src="/uploads/logo.svg" alt={SITE_TITLE} width="180" height="36" />
			<h2>八生建設について</h2>
			<p>
				創業以来、建築施工管理で培った豊富な経験と高度な技術に加え、先を見据えたビジネスの研鑚を積み重ね、より良い生活環境の創造と、活力ある社会の発展に貢献してまいりました。
			</p>
			<p>
				今後も建築のエキスパートとしての価値を高め、皆さまにご満足いただけるソリューションを提供できる企業として、さらなる発展を目指してまいります。
			</p>
		</div>

		<nav class="sitemap" aria-label="フッターナビゲーション">
			<ul>
				<li><a href="/">トップページ</a></li>
				<li><a href="/works/">施工事例一覧</a></li>
				<li><a href="/company/">企業情報</a></li>
				<li><a href="/recruit/">採用情報</a></li>
				<li><a href="/information/">インフォメーション</a></li>
				<li><a href="/contact/">お問い合わせ</a></li>
				<li><a href="/entry/">エントリーフォーム</a></li>
			</ul>
		</nav>

		<div class="latest">
			<h2>新着情報</h2>
			<ul>
				{
					news.map((post) => (
						<li>
							<a href={newsPermalink(post)}>
								<time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
								<span>{post.data.title}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="contact">
			<h2>お問い合わせ</h2>
			<address>
				{COMPANY.addressShort}<br />
				TEL <a href={`tel:${COMPANY.tel.replace(/-/g, '')}`}>{COMPANY.tel}</a><br />
				FAX {COMPANY.fax}
			</address>
		</div>
	</div>

	<div class="bottom">
		<small>{COMPANY.copyright}</small>
		<ul>
			<li><a href="/privacy/">プライバシーポリシー</a></li>
			<li><a href="/terms/">利用規約</a></li>
		</ul>
	</div>
</footer>

<style>
	.cta {
		background: #0a5c9e;
		color: #fff;
		text-align: center;
		padding: 3rem 1.25rem;
	}
	.cta-lead {
		margin: 0 0 1.5rem;
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.7;
	}
	.btn {
		display: inline-block;
		padding: 0.85rem 3rem;
		background: #fff;
		color: #0a5c9e;
		font-weight: 700;
		text-decoration: none;
		border-radius: 999px;
	}
	.btn:hover {
		opacity: 0.85;
	}

	.site-footer {
		background: #1a1a1a;
		color: #ddd;
		padding: 3.5rem 1.25rem 1.5rem;
		font-size: 0.9rem;
	}
	.site-footer .inner {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1.4fr 1fr;
		gap: 2.5rem;
		max-width: 1200px;
		margin: 0 auto;
	}
	.footer-logo {
		height: 36px;
		width: auto;
		margin-bottom: 1rem;
		filter: brightness(0) invert(1);
	}
	.site-footer h2 {
		margin: 0 0 0.85rem;
		font-size: 1rem;
		color: #fff;
	}
	.site-footer p {
		margin: 0 0 0.85rem;
		line-height: 1.9;
	}
	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.site-footer li {
		margin-bottom: 0.6rem;
	}
	.site-footer a {
		color: #ddd;
		text-decoration: none;
	}
	.site-footer a:hover {
		color: #fff;
		text-decoration: underline;
	}
	.latest time {
		display: block;
		font-size: 0.78rem;
		color: #999;
	}
	address {
		font-style: normal;
		line-height: 1.9;
	}

	.bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1200px;
		margin: 2.5rem auto 0;
		padding-top: 1.25rem;
		border-top: 1px solid #333;
	}
	.bottom ul {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.bottom li {
		margin: 0;
	}

	@media (max-width: 900px) {
		.site-footer .inner {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 600px) {
		.site-footer .inner {
			grid-template-columns: 1fr;
		}
	}
</style>
