---
import '../styles/fonts.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import headerHtml from '../fragments/index/header.html?raw';
import footerHtml from '../fragments/index/footer.html?raw';

interface Props {
	title: string;
	description?: string;
	/** OGP 画像（public 配下のパス） */
	image?: string;
	/** 元テーマの body クラス（CSS がこれに依存しています） */
	bodyClass?: string;
	/** 採用ページのフェード演出用スクリプトを読み込む */
	recruitScript?: boolean;
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = '/uploads/company_top_img.jpg',
	bodyClass = '',
	recruitScript = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// オープニングの暗幕アニメーション（.loading）はトップページ限定。
// 下層ページでは要素ごと外して、画面が下から上へめくれる演出を出さない。
const isHome = bodyClass.split(/\s+/).includes('home');
const header = isHome ? headerHtml : headerHtml.replace('<div class="loading"></div>', '');
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<!-- オリジナルテーマのスタイル -->
		<link rel="stylesheet" href="/assets/css/slick.css" />
		<link rel="stylesheet" href="/assets/css/slick-theme.css" />
		<link rel="stylesheet" href="/assets/css/theme.css" />
		<link rel="stylesheet" href="/assets/css/pages.css" />
		<link rel="stylesheet" href="/assets/css/cf7.css" />
		<link rel="stylesheet" href="/assets/css/cf7-conditional.css" />
		<link rel="stylesheet" href="/assets/css/cf7-multistep.css" />
	</head>

	<body class={`wp-embed-responsive wp-theme-hassei-themes ${bodyClass}`.trim()}>
		<Fragment set:html={header} />

		<slot />

		<Fragment set:html={footerHtml} />

		<!-- オリジナルテーマのスクリプト（読み込み順は元サイトに合わせています） -->
		<script is:inline src="/assets/js/jquery.min.js"></script>
		<script is:inline src="/assets/js/gsap.min.js"></script>
		<script is:inline src="/assets/js/ScrollTrigger.min.js"></script>
		<script is:inline src="/assets/js/my-ajax.js"></script>
		<script is:inline src="/assets/js/script.js"></script>
		<script is:inline src="/assets/js/slick.min.js"></script>
		<script is:inline src="/assets/js/home.js"></script>
		{recruitScript && <script is:inline src="/assets/js/recruitpage.js" />}
		{recruitScript && <script is:inline src="/assets/js/recruit-fade.js" />}
	</body>
</html>
