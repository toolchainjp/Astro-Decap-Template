---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
	post: CollectionEntry<'news'>;
	prev: CollectionEntry<'news'> | null;
	next: CollectionEntry<'news'> | null;
}

const { post, prev, next } = Astro.props;
const { title, pubDate, category, heroImage } = post.data;

const recent = (await getCollection('news'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<Base
	title={`${title} | インフォメーション | 八生建設株式会社`}
	description={title}
	image={heroImage}
	breadcrumbs={[{ href: '/information/', label: 'インフォメーション' }, { label: title }]}
>
	<article class="post">
		<div class="inner">
			<p class="category">{category}</p>
			<h1>{title}</h1>
			<p class="date">Date: <FormattedDate date={pubDate} /></p>

			{
				heroImage && (
					<figure class="hero">
						<img src={heroImage} alt={title} width="1200" height="675" />
					</figure>
				)
			}

			<div class="body">
				<slot />
			</div>

			<nav class="pager" aria-label="記事ナビゲーション">
				{prev ? <a href={prev.data.permalink}>Prev</a> : <span />}
				<a class="back" href="/information/">インフォメーション一覧へ</a>
				{next ? <a href={next.data.permalink}>Next</a> : <span />}
			</nav>
		</div>

		<aside class="recent">
			<div class="inner">
				<h2>Recent Post</h2>
				<ul>
					{
						recent.map((item) => (
							<li>
								<a href={item.data.permalink}>
									<span class="r-title">{item.data.title}</span>
									<span class="r-meta">
										<FormattedDate date={item.data.pubDate} /> / {item.data.category}
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<a class="more" href="/information/">View More</a>
			</div>
		</aside>
	</article>
</Base>

<style>
	.inner {
		max-width: 860px;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	.post {
		padding-top: 3rem;
	}
	.category {
		display: inline-block;
		margin: 0 0 1rem;
		padding: 0.3rem 0.9rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: #fff;
		background: #0a5c9e;
		border-radius: 999px;
	}
	h1 {
		margin: 0 0 0.75rem;
		font-size: 1.75rem;
		line-height: 1.5;
	}
	.date {
		margin: 0 0 2rem;
		font-size: 0.85rem;
		color: #888;
	}
	.hero {
		margin: 0 0 2.5rem;
	}
	.hero img {
		width: 100%;
		height: auto;
		display: block;
	}
	.body :global(h2) {
		margin: 2.5rem 0 1rem;
		padding-bottom: 0.5rem;
		font-size: 1.2rem;
		border-bottom: 2px solid #0a5c9e;
	}
	.body :global(p) {
		margin: 0 0 1.25rem;
		line-height: 2;
	}
	.body :global(ul) {
		margin: 0 0 1.5rem;
		padding-left: 1.25rem;
		line-height: 2;
	}
	.body :global(a) {
		color: #0a5c9e;
	}

	.pager {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid #e6e6e6;
	}
	.pager a {
		color: #0a5c9e;
		font-weight: 700;
		text-decoration: none;
	}
	.pager .back {
		color: #1a1a1a;
	}

	.recent {
		margin-top: 4rem;
		padding: 3rem 0 5rem;
		background: #f7f7f7;
	}
	.recent h2 {
		margin: 0 0 1.5rem;
		font-size: 1.1rem;
	}
	.recent ul {
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
	}
	.recent li {
		border-bottom: 1px solid #e2e2e2;
	}
	.recent a {
		display: block;
		padding: 0.9rem 0;
		color: inherit;
		text-decoration: none;
	}
	.recent a:hover .r-title {
		color: #0a5c9e;
	}
	.r-title {
		display: block;
		font-weight: 600;
	}
	.r-meta {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.78rem;
		color: #888;
	}
	.more {
		font-weight: 700;
		color: #0a5c9e;
		text-decoration: none;
	}
</style>
