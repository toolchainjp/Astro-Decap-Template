---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import CtaSection from '../../components/site/CtaSection.astro';
import RecruitBanner from '../../components/site/RecruitBanner.astro';
import { getWorks } from '../../lib/collections';
import { findClassification, tagPath, worksThumbnail } from '../../lib/taxonomy';

export const getStaticPaths: GetStaticPaths = async () => {
	const works = await getWorks();
	return works.map((entry, index) => ({
		params: { slug: entry.id },
		props: {
			entry,
			// 一覧と同じ並び順で前後の事例へ送ります。
			prev: works[index - 1] ?? null,
			next: works[index + 1] ?? null,
		},
	}));
};

const { entry, prev, next } = Astro.props;
const { title, location, structure, scale, completion, specs, images, tags } = entry.data;
const classification = findClassification(entry.data.classification);
const { Content } = await render(entry);

// 定型の4項目と、CMSで自由に足せる specs をまとめて表に出します。
const rows = [
	{ label: '所在地', value: location },
	{ label: '構造', value: structure },
	{ label: '規模', value: scale },
	{ label: '竣工', value: completion },
	...specs,
].filter((row) => row.value);
---

<Site
	title={`${title} | 施工事例 | 八生建設株式会社`}
	description={`${title}｜八生建設の施工事例。`}
	image={worksThumbnail(entry.data)}
	bodyClass="wp-singular works-template-default single single-works"
>
	<Breadcrumbs items={[{ href: '/works/', label: '施工実績' }, { label: title }]} />

	<section class="case-header">
		<div class="case-heading-wrap container">
			<h1 class="case-ttl">{title}</h1>
			<p class="case-cat">HASSEI.works</p>
		</div>
	</section>

	<section class="case-data">
		<div class="data-sec outer-container">
			<div class="data-wrap">
				<dl>
					<dt>用途&ensp;:</dt>
					<dd>
						<a href={`/works/classification/${classification.slug}/`}>{classification.label}</a>
					</dd>
				</dl>
				{
					rows.map((row) => (
						<dl>
							<dt>{row.label}&ensp;:</dt>
							<dd>{row.value}</dd>
						</dl>
					))
				}
			</div>
		</div>
	</section>

	<section class="standard-sec case">
		<div class="container standard-wrap">
			{images.map((src) => <p class="case-img"><img decoding="async" loading="lazy" alt={title} class="alignnone size-full" src={src} /></p>)}

			<div class="case-body">
				<Content />
			</div>

			{
				tags.length > 0 && (
					<ul class="case-tags">
						{tags.map((tag) => (
							<li>
								<a href={tagPath('/works', tag)}>#{tag}</a>
							</li>
						))}
					</ul>
				)
			}

			<div class="pagination-single">
				{
					prev ? (
						<div class="btn prev-page">
							<a href={`/works/${prev.id}/`} rel="prev">
								Prev
							</a>
						</div>
					) : (
						<div class="btn prev-page inactive" />
					)
				}
				{
					next ? (
						<div class="btn next-page">
							<a href={`/works/${next.id}/`} rel="next">
								Next
							</a>
						</div>
					) : (
						<div class="btn next-page inactive" />
					)
				}
			</div>

			<div class="back-to-works">
				<a href="/works/" class="back-to-works-link">施工事例一覧に戻る</a>
			</div>
		</div>
	</section>

	<RecruitBanner />
	<CtaSection />
</Site>

<style>
	.case-body:empty {
		display: none;
	}
	.case-body :global(p) {
		margin: 0 0 1.25rem;
		line-height: 2;
	}
	.case-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}
	.case-tags a {
		display: inline-block;
		padding: 0.35rem 0.9rem;
		border: 1px solid #ccc;
		border-radius: 999px;
		font-size: 0.82rem;
		color: inherit;
		text-decoration: none;
	}
	.case-tags a:hover {
		border-color: #185ef1;
		color: #185ef1;
	}
</style>
